<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mobile_dashboard_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BMS Mobile"
            android:textColor="#F6FAFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Live battery telemetry from your PC backend"
            android:textColor="#9DB2CF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/mobile_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="http://192.168.31.70:8090"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#F6FAFF"
                android:textColorHint="#7D90AA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save" />

                <Button
                    android:id="@+id/refreshButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Refresh" />

                <Button
                    android:id="@+id/autoRefreshButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Auto: ON" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/mobile_status_bg"
            android:padding="12dp"
            android:text="Loading..."
            android:textColor="#DCE7F7"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lastUpdateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Waiting for refresh..."
            android:textColor="#8FA3BF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/moduleCardsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/mobile_card_bg"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:text="No telemetry yet."
            android:textColor="#F6FAFF"
            android:textSize="17sp" />

        <com.piotrek.bmsmobileviewer.BmsChartView
            android:id="@+id/voltageChart"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="14dp" />

        <com.piotrek.bmsmobileviewer.BmsChartView
            android:id="@+id/currentChart"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="14dp" />

        <com.piotrek.bmsmobileviewer.BmsChartView
            android:id="@+id/socChart"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="14dp" />

        <com.piotrek.bmsmobileviewer.BmsChartView
            android:id="@+id/cellsChart"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/cellsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/mobile_card_bg"
            android:padding="16dp"
            android:text="No cell data yet."
            android:textColor="#CFE0F7"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/rawText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/mobile_card_bg"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:text=""
            android:textColor="#8FA3BF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
